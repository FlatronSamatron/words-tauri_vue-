{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Words",
  "version": "0.1.0",
  "identifier": "com.words.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Words",
        "width": 800,
        "height": 600
      },
      {
        "label": "game",
        "url": "/#/game",
        "title": "",
        "width": 320,
        "height": 280,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "center": true,
        "alwaysOnTop": true,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}